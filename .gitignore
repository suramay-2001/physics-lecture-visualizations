# Raw and extracted course sources are copyrighted (instructor notes, textbooks).
# They stay local; the app paraphrases and cites page numbers instead.
sources/

node_modules/
dist/
.DS_Store
*.local
graphify-out/cache/
app/test-results/
app/playwright-report/
app/e2e/__screens__/
__pycache__/

# Local source paths for the pipeline (see course.config.local.example.json)
pipeline/course.config.local.json

# Agent worktrees
.claude/worktrees/

# Blender: scripts are the source of truth; data is regenerable, .blend files are scratch (decision P3 #4)
pipeline/blender/data/
*.blend
*.blend1

# Motion Canvas films (films/README.md): renders, manifests and timings are regenerable; node_modules is ignored above
films/output/

# Never commit course material, personal documents or credentials (pipeline/audit_public.py checks the same)
*.pdf
*.epub
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
.env
.env.*
*.pem
*.p12
*.key
.claude/settings.local.json
